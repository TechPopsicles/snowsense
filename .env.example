# ── Snowflake ──────────────────────────────────────────────────────────────────
SF_ACCOUNT=your-account-identifier      # e.g. xy12345.us-east-1
SF_USER=your_username
SF_ROLE=ACCOUNTADMIN                    # needs MONITOR privilege for query_history
SF_WAREHOUSE=COMPUTE_XS                 # default warehouse before fingerprint routing
SF_DATABASE=ANALYTICS                   # Snowflake database for dbt marts
SF_SCHEMA=PUBLIC

# Auth — choose one:
SF_PASSWORD=your_password               # plain password
# PRIVATE_KEY_PATH=/run/secrets/rsa_key.p8  # uncomment for key-pair auth (recommended)

# Available warehouse sizes the agent can choose from (comma-separated)
AVAILABLE_WAREHOUSES=COMPUTE_XS,COMPUTE_M,COMPUTE_L,COMPUTE_XL

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Postgres / pgvector (set automatically by docker-compose) ──────────────────
# Override only when running scripts locally against a non-Docker postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=snowsense
PG_USER=snowsense
PG_PASSWORD=snowsense

# ── LangSmith tracing (optional) ───────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=snowsense
